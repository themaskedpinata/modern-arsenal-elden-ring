+impl BulletSpawnData {
+    /// Spawn data for one bullet: `owner` fires `bullet_id` from `position` along the forward
+    /// vector `angle`. Behavior/magic/goods/dummy-poly ids are -1, the target override is the
+    /// empty handle and every unknown field is zero.
+    pub fn new(
+        owner: FieldInsHandle,
+        bullet_id: i32,
+        position: F32Vector4,
+        angle: F32Vector4,
+    ) -> Self {
+        // SAFETY: every field is plain old data (integers, floats, byte arrays and bitfield
+        // newtypes over integers), so the all-zero bit pattern is a valid value.
+        let mut d: Self = unsafe { core::mem::zeroed() };
+        d.owner = owner;
+        d.bullet_id = bullet_id;
+        d.behavior_id = -1;
+        d.magic_id = -1;
+        d.goods_id = -1;
+        d.dummy_poly_id = -1;
+        d.target = FieldInsHandle::none();
+        d.position = position;
+        d.angle = angle;
+        d
+    }
+}
