+
+            // mw2er patch 0001: pre-ImGui callback (draws under the HUD), then hudhook's own state again.
+            if let Some(cb) = crate::hooks::dx12::pre_imgui::PRE_IMGUI.get() {
+                let desc = render_target.GetDesc();
+                let ctx = crate::hooks::dx12::pre_imgui::PreImguiCtx {
+                    device: &self.device,
+                    command_list: &self.command_list,
+                    command_queue: &self.command_queue,
+                    render_target: &render_target,
