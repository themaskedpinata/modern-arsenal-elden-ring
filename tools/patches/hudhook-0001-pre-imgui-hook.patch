+type DXGISwapChainSetColorSpace1Type =
+    unsafe extern "system" fn(this: IDXGISwapChain3, color_space: i32) -> HRESULT;
+
+/// mw2er patch 0001: a callback that records draws into hudhook's own DX12 command list right after the back
+/// buffer is bound (RENDER_TARGET state) and before ImGui's draw data. The callback must set every piece of
+/// pipeline state it uses and must not leave the back buffer in another state; hudhook re-binds its render
+/// target and restores its own state afterwards. A panic inside the callback is caught and counted.
+pub mod pre_imgui {
+    use std::sync::atomic::{AtomicI32, AtomicU64};
+    use std::sync::OnceLock;
+
+    use windows::Win32::Graphics::Direct3D12::{
+        ID3D12CommandQueue, ID3D12Device, ID3D12GraphicsCommandList, ID3D12Resource,
+        D3D12_CPU_DESCRIPTOR_HANDLE,
+    };
+    use windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT;
+
+    /// Everything the callback gets, valid only during the call.
+    pub struct PreImguiCtx<'a> {
+        /// The device of the game's present queue.
+        pub device: &'a ID3D12Device,
+        /// hudhook's command list, open, with the back buffer in RENDER_TARGET state.
+        pub command_list: &'a ID3D12GraphicsCommandList,
+        /// The game's present queue (the list is executed on it after ImGui).
+        pub command_queue: &'a ID3D12CommandQueue,
+        /// The current back buffer.
+        pub render_target: &'a ID3D12Resource,
+        /// hudhook's RTV of the back buffer.
+        pub rtv: D3D12_CPU_DESCRIPTOR_HANDLE,
+        /// The RTV format (sRGB swap-chain formats are viewed as UNORM).
+        pub rtv_format: DXGI_FORMAT,
+        /// Back-buffer width.
+        pub width: u32,
+        /// Back-buffer height.
+        pub height: u32,
+        /// hudhook's frame slot; its fence was waited on before this frame was recorded.
+        pub frame_index: usize,
+        /// Number of frame slots.
+        pub num_frames: usize,
+    }
+
+    /// The callback (set once, before hudhook is applied).
+    pub static PRE_IMGUI: OnceLock<Box<dyn Fn(&PreImguiCtx) + Send + Sync>> = OnceLock::new();
+    /// Panics caught around the callback.
+    pub static PRE_IMGUI_PANICS: AtomicU64 = AtomicU64::new(0);
+    /// The last colour space passed to IDXGISwapChain3::SetColorSpace1 (-1 = never called).
+    pub static LAST_COLOR_SPACE: AtomicI32 = AtomicI32::new(-1);
+}
