+                    width: desc.Width as u32,
+                    height: desc.Height,
+                    frame_index: self.frame_index,
+                    num_frames: NUM_FRAMES,
+                };
+                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| cb(&ctx)));
+                if r.is_err() {
+                    crate::hooks::dx12::pre_imgui::PRE_IMGUI_PANICS
+                        .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
